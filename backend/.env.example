# ============================================================
# ZAMANI BURGER backend environment
# Copy this file to .env for local development.
# In production (Render) set the same keys in the dashboard.
# ============================================================

# --- Core ---------------------------------------------------
DEBUG=True
SECRET_KEY=replace-this-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost,testserver,pr.zamaniburger.ir

# --- Database ----------------------------------------------
# Leave empty locally to use SQLite (backend/db.sqlite3).
# In production set the Postgres URL (Neon / Supabase / Render):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- Frontend / CORS ---------------------------------------
# Comma separated. In production add the Vercel domain:
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Defaults to CORS_ALLOWED_ORIGINS when empty.
CSRF_TRUSTED_ORIGINS=
